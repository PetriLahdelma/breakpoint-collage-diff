{
  "name": "breakpoint-collage-diff",
  "version": "0.1.1",
  "description": "Playwright CLI to collage breakpoints and diff against baselines.",
  "keywords": [
    "visual-regression",
    "playwright",
    "screenshots",
    "ci",
    "frontend",
    "cli"
  ],
  "type": "module",
  "bin": {
    "breakpoint-collage-diff": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && node dist/index.js --url https://example.com",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node test/slug.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "render": "node scripts/render-hero.mjs && node scripts/render-og.mjs && node scripts/render-before-after.mjs && node scripts/render-readme.mjs",
    "brand:build": "node scripts/brand-build.mjs",
    "brand:screenshots": "node scripts/brand-screenshots.mjs",
    "brand:demo": "node scripts/brand-demo.mjs"
  },
  "dependencies": {
    "playwright": "^1.49.0",
    "sharp": "^0.33.5",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PetriLahdelma/breakpoint-collage-diff.git"
  },
  "homepage": "https://github.com/PetriLahdelma/breakpoint-collage-diff#readme",
  "bugs": {
    "url": "https://github.com/PetriLahdelma/breakpoint-collage-diff/issues"
  },
  "devDependencies": {
    "@types/node": "^25.2.2",
    "@types/pixelmatch": "^5.2.4",
    "@types/pngjs": "^6.0.0",
    "typescript": "^5.5.4",
    "svgo": "^3.3.2"
  }
}
